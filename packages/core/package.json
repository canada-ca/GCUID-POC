{
  "name": "@gcuid/core",
  "version": "0.1.0",
  "description": "Core identity management functionality",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gcuid": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "npm run build && node dist/examples.js",
    "example:v2": "npm run build && node dist/examples-v2.js",
    "example:registry": "npm run build && node dist/registry-examples.js",
    "cli": "npm run build && node dist/cli.js",
    "migrate": "npm run build && node dist/migrate-to-v2.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "keywords": [
    "identity",
    "gcuid",
    "core",
    "urn",
    "identifier"
  ],
  "author": "",
  "license": "LicenseRef-NOETRONIQ-Proprietary",
  "dependencies": {
    "@types/express": "^5.0.6",
    "better-sqlite3": "^12.6.2",
    "convict": "^6.2.4",
    "express": "^5.2.1",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xstate": "^5.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/convict": "^6.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
