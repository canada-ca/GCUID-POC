{
  "systemId": "conn-engineering",
  "displayName": "Engineering Department System",
  "systemType": "department",
  "accessMode": "scheduled-pull",
  "enabled": true,
  "description": "Engineering department HR system managing staff including full-time, part-time, and contractors. Requests GCUIDs for employees and links to authoritative HR/LDAP records.",
  "gcuidIntegration": {
    "registryUrl": "http://localhost:5182",
