{
  "name": "gcuid-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Government of Canada Unique Identifier - A centralized identity system with federated attribute retrieval",
  "workspaces": [
    "packages/*",
    "staging"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "smoke": "node scripts/run-smokes.js",
    "smoke:list": "node scripts/run-smokes.js --list",
    "smoke:all": "node scripts/run-smokes.js --all"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
